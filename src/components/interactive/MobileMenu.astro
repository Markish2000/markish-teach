---
import type { Locale } from "@shared/types";
import { localePath, type Alternates } from "@shared/constants";
import { getTranslations } from "@i18n";
import Brand from "@shared/components/brand/Brand.astro";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  readonly locale: Locale;
  readonly alternates: Alternates;
  readonly links: ReadonlyArray<{ label: string; href: string; current: boolean }>;
  readonly ctaHref: string;
}

const { locale, alternates, links, ctaHref } = Astro.props;
const t = getTranslations(locale);
---

<button
  type="button"
  class="icon-btn menu-trigger"
  data-mobile-menu-trigger
  aria-label={t.a11y.open_menu}
  aria-expanded="false"
  aria-controls="mobile-menu-sheet"
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
    <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>

<div
  id="mobile-menu-sheet"
  class="mobile-menu"
  data-mobile-menu
  role="dialog"
  aria-modal="true"
  aria-label={t.a11y.menu_title}
  inert
>
  <div class="top">
    <Brand
      variant="lockup"
      href={localePath(locale, "home")}
      label={t.a11y.home_link}
      loading="lazy"
      data-mobile-menu-link
    />
    <button type="button" class="icon-btn" data-mobile-menu-close aria-label={t.a11y.close_menu}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav aria-label={t.a11y.primary_nav}>
    {links.map((link, index) => (
      <a href={link.href} data-mobile-menu-link aria-current={link.current ? "page" : undefined}>
        <span class="num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="foot">
    <LangSwitch locale={locale} alternates={alternates} />
    <ThemeToggle locale={locale} />
    <a class="btn btn-primary" href={ctaHref} data-mobile-menu-link>
      {t.nav.cta}
    </a>
  </div>
</div>
