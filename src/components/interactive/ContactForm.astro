---
import type { ContactFormProps } from "./ContactForm.interfaces";

type Props = ContactFormProps;

const { labels, endpoint } = Astro.props;
const messageMin = 8;
const minMessage = labels.error_min.replace("{min}", String(messageMin));
---

<div class="contact-form-shell" data-contact-shell>
  <form
    class="contact-form"
    data-contact-form
    data-endpoint={endpoint}
    data-error-required={labels.error_required}
    data-error-email={labels.error_email}
    data-error-min={minMessage}
    data-error-generic={labels.error_generic}
    data-submit-label={labels.submit}
    data-sending-label={labels.sending}
    novalidate
  >
    <div class="field-row">
      <div class="field">
        <label for="contact-name">{labels.name}</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          aria-describedby="contact-name-error"
        />
        <span id="contact-name-error" role="alert" class="field-error" data-field-error="name" hidden></span>
      </div>
      <div class="field">
        <label for="contact-email">{labels.email}</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          aria-describedby="contact-email-error"
        />
        <span id="contact-email-error" role="alert" class="field-error" data-field-error="email" hidden></span>
      </div>
    </div>

    <div class="field">
      <label id="contact-service-label" for="contact-service">{labels.service}</label>
      <div class="select" data-select data-placeholder={labels.service_placeholder}>
        <button
          type="button"
          id="contact-service"
          class="select-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="contact-service-list"
          aria-labelledby="contact-service-label contact-service-value"
          aria-describedby="contact-service-error"
          data-select-trigger
        >
          <span id="contact-service-value" class="select-value is-placeholder" data-select-value>
            {labels.service_placeholder}
          </span>
          <svg class="select-chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M4 6l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <input type="hidden" name="service" value="" />
        <ul id="contact-service-list" class="select-list" role="listbox" tabindex="-1" hidden data-select-list>
          {labels.service_opts.map((option) => (
            <li class="select-option" role="option" aria-selected="false" tabindex="-1" data-value={option}>
              <span>{option}</span>
              <svg class="select-check" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M3 8.5l3.5 3.5L13 5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </li>
          ))}
        </ul>
      </div>
      <span id="contact-service-error" role="alert" class="field-error" data-field-error="service" hidden></span>
    </div>

    <div class="field">
      <label for="contact-message">{labels.message}</label>
      <textarea
        id="contact-message"
        name="message"
        data-min-length={messageMin}
        aria-describedby="contact-message-error"
      ></textarea>
      <span id="contact-message-error" role="alert" class="field-error" data-field-error="message" hidden></span>
    </div>

    <button
      type="submit"
      class="btn btn-primary"
      data-submit-button
      aria-busy="false"
    >
      <span data-submit-text>{labels.submit}</span>
      <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <div role="alert" class="field-error form-error" data-form-error hidden>
      {labels.error_generic}
    </div>
  </form>

  <div class="contact-success" role="status" aria-live="polite" data-contact-success hidden>
    <span class="check-medallion" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 12l4 4 10-10"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    <p style="margin: 0">{labels.sent}</p>
  </div>
</div>

<script>
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const getText = (form: HTMLFormElement, key: string, fallback = ""): string =>
    form.dataset[key] ?? fallback;

  const setFieldError = (
    form: HTMLFormElement,
    fieldName: string,
    message: string
  ): void => {
    const field = form.elements.namedItem(fieldName);
    const error = form.querySelector<HTMLElement>(`[data-field-error="${fieldName}"]`);
    if (field instanceof HTMLElement) {
      field.setAttribute("aria-invalid", message ? "true" : "false");
    }
    const trigger = field instanceof HTMLInputElement && field.type === "hidden"
      ? field.parentElement?.querySelector<HTMLElement>("[data-select-trigger]")
      : null;
    trigger?.setAttribute("aria-invalid", message ? "true" : "false");
    if (!error) return;
    error.textContent = message;
    error.hidden = message.length === 0;
  };

  const getValue = (form: HTMLFormElement, fieldName: string): string => {
    const field = form.elements.namedItem(fieldName);
    return field instanceof HTMLInputElement ||
      field instanceof HTMLSelectElement ||
      field instanceof HTMLTextAreaElement
      ? field.value.trim()
      : "";
  };

  const validateForm = (form: HTMLFormElement): boolean => {
    const required = getText(form, "errorRequired");
    const emailError = getText(form, "errorEmail");
    const minError = getText(form, "errorMin");
    let valid = true;

    const values = {
      name: getValue(form, "name"),
      email: getValue(form, "email"),
      service: getValue(form, "service"),
      message: getValue(form, "message"),
    };

    setFieldError(form, "name", values.name ? "" : required);
    setFieldError(
      form,
      "email",
      !values.email ? required : emailPattern.test(values.email) ? "" : emailError
    );
    setFieldError(form, "service", values.service ? "" : required);
    setFieldError(form, "message", values.message.length >= 8 ? "" : minError);

    valid = Boolean(
      values.name &&
        values.email &&
        emailPattern.test(values.email) &&
        values.service &&
        values.message.length >= 8
    );
    return valid;
  };

  const setSubmitting = (form: HTMLFormElement, submitting: boolean): void => {
    const button = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const text = form.querySelector<HTMLElement>("[data-submit-text]");
    if (button) {
      button.disabled = submitting;
      button.setAttribute("aria-busy", submitting ? "true" : "false");
    }
    if (text) {
      text.textContent = submitting
        ? getText(form, "sendingLabel")
        : getText(form, "submitLabel");
    }
  };

  const initSelect = (root: HTMLElement): void => {
    const trigger = root.querySelector<HTMLButtonElement>("[data-select-trigger]");
    const list = root.querySelector<HTMLElement>("[data-select-list]");
    const valueEl = root.querySelector<HTMLElement>("[data-select-value]");
    const hidden = root.querySelector<HTMLInputElement>("input[type='hidden']");
    if (!trigger || !list || !valueEl || !hidden) return;
    const placeholder = root.dataset["placeholder"] ?? "";
    const options = Array.from(list.querySelectorAll<HTMLElement>("[role='option']"));

    const isOpen = (): boolean => !list.hidden;

    const close = (refocus: boolean): void => {
      list.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (refocus) trigger.focus();
    };

    const open = (): void => {
      list.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      (options.find((o) => o.getAttribute("aria-selected") === "true") ?? options[0])?.focus();
    };

    const select = (option: HTMLElement): void => {
      const value = option.dataset["value"] ?? "";
      hidden.value = value;
      valueEl.textContent = value;
      valueEl.classList.remove("is-placeholder");
      options.forEach((o) => o.setAttribute("aria-selected", String(o === option)));
      hidden.dispatchEvent(new Event("input", { bubbles: true }));
      close(true);
    };

    const clear = (): void => {
      hidden.value = "";
      valueEl.textContent = placeholder;
      valueEl.classList.add("is-placeholder");
      options.forEach((o) => o.setAttribute("aria-selected", "false"));
    };

    trigger.addEventListener("click", () => (isOpen() ? close(false) : open()));
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        open();
      }
    });

    options.forEach((option, index) => {
      option.addEventListener("click", () => select(option));
      option.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          options[(index + 1) % options.length]?.focus();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          options[(index - 1 + options.length) % options.length]?.focus();
        } else if (event.key === "Home") {
          event.preventDefault();
          options[0]?.focus();
        } else if (event.key === "End") {
          event.preventDefault();
          options[options.length - 1]?.focus();
        } else if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          select(option);
        } else if (event.key === "Escape") {
          event.preventDefault();
          close(true);
        } else if (event.key === "Tab") {
          close(false);
        }
      });
    });

    document.addEventListener("click", (event) => {
      if (isOpen() && event.target instanceof Node && !root.contains(event.target)) close(false);
    });
    root.closest("form")?.addEventListener("reset", clear);
  };

  document.querySelectorAll<HTMLElement>("[data-select]").forEach(initSelect);

  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const formError = form.querySelector<HTMLElement>("[data-form-error]");

    form.addEventListener("input", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement)) return;
      setFieldError(form, target.name, "");
      if (formError) formError.hidden = true;
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (formError) formError.hidden = true;

      if (!validateForm(form)) {
        form.querySelector<HTMLElement>("[aria-invalid='true']")?.focus();
        return;
      }

      const data = {
        name: getValue(form, "name"),
        email: getValue(form, "email"),
        service: getValue(form, "service"),
        message: getValue(form, "message"),
      };

      setSubmitting(form, true);
      try {
        const response = await fetch(form.dataset["endpoint"] ?? "/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!response.ok) throw new Error("send_failed");

        const shell = form.closest<HTMLElement>("[data-contact-shell]");
        const success = shell?.querySelector<HTMLElement>("[data-contact-success]");
        form.reset();
        form.hidden = true;
        if (success) success.hidden = false;
      } catch {
        if (formError) {
          formError.textContent = getText(form, "errorGeneric");
          formError.hidden = false;
        }
      } finally {
        setSubmitting(form, false);
      }
    });
  });
</script>
