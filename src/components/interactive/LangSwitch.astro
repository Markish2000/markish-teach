---
import { LOCALES } from "@shared/types";
import type { Locale } from "@shared/types";
import { LANG_TAG } from "@shared/helpers";
import { localePath, type Alternates } from "@shared/constants";
import { getTranslations } from "@i18n";

interface Props {
  readonly locale: Locale;
  /** Equivalent page in each locale; falls back to that locale's home. */
  readonly alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const t = getTranslations(locale);
---

<div class="lang-switch" role="group" aria-label={t.a11y.lang_group}>
  {LOCALES.map((l) => {
    const isCurrent = l === locale;
    const target = getTranslations(l);
    return (
      <a
        href={alternates[l] ?? localePath(l, "home")}
        class:list={[isCurrent && "is-active"]}
        aria-current={isCurrent ? "page" : undefined}
        hreflang={LANG_TAG[l]}
        lang={LANG_TAG[l]}
      >
        {l}<span class="sr-only"> · {target.lang_name}</span>
      </a>
    );
  })}
</div>
