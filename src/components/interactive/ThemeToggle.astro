---
import type { Locale } from "@shared/types";
import { getTranslations } from "@i18n";

interface Props {
  readonly locale: Locale;
}

const t = getTranslations(Astro.props.locale).a11y;
---

<!-- The label names the action; Header's script syncs it with the active theme. -->
<button
  type="button"
  class="icon-btn"
  data-theme-toggle
  aria-label={t.theme_to_light}
  data-label-light={t.theme_to_light}
  data-label-dark={t.theme_to_dark}
>
  <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
    <path
      d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17m10-10l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  </svg>
</button>
