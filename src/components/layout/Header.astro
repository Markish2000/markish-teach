---
import type { Locale } from "@shared/types";
import { localePath, type Alternates } from "@shared/constants";
import { getTranslations } from "@i18n";
import Brand from "@shared/components/brand/Brand.astro";
import Button from "@shared/components/primitives/Button.astro";
import LangSwitch from "@components/interactive/LangSwitch.astro";
import ThemeToggle from "@components/interactive/ThemeToggle.astro";
import MobileMenu from "@components/interactive/MobileMenu.astro";

type NavKey = "services" | "projects" | "about" | "faq" | "contact";

interface Props {
  readonly locale: Locale;
  readonly alternates: Alternates;
  readonly current?: NavKey | undefined;
}

const { locale, alternates, current } = Astro.props;
const t = getTranslations(locale);

const navLinks = (["services", "projects", "about", "faq", "contact"] as const).map((key) => ({
  label: key === "faq" ? t.nav.faq_short : t.nav[key],
  href: localePath(locale, key),
  current: key === current,
}));
const contactHref = localePath(locale, "contact");
---

<header class="nav" id="site-header">
  <Brand variant="lockup" href={localePath(locale, "home")} label={t.a11y.home_link} />
  <nav class="nav-links" aria-label={t.a11y.primary_nav}>
    {navLinks.map((link) => (
      <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
    ))}
  </nav>
  <div class="nav-tools">
    <LangSwitch locale={locale} alternates={alternates} />
    <ThemeToggle locale={locale} />
    <Button variant="primary" href={contactHref} label={t.nav.cta} className="nav-cta" />
    <MobileMenu locale={locale} alternates={alternates} links={navLinks} ctaHref={contactHref} />
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById("site-header");
    if (!header) return;
    var onScroll = function () {
      header.classList.toggle("is-scrolled", window.scrollY > 30);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();

  (function () {
    var root = document.documentElement;
    var syncLabels = function () {
      var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
      document.querySelectorAll("[data-theme-toggle]").forEach(function (button) {
        button.setAttribute("aria-label", button.getAttribute("data-label-" + next) || "");
      });
    };
    syncLabels();
    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!(target instanceof Element) || !target.closest("[data-theme-toggle]")) return;
      var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("mk-theme", next);
      } catch (e) {
        /* Storage unavailable: the choice lasts for this page only. */
      }
      syncLabels();
    });
  })();

  (function () {
    var trigger = document.querySelector("[data-mobile-menu-trigger]");
    var menu = document.querySelector("[data-mobile-menu]");
    if (!(trigger instanceof HTMLElement) || !(menu instanceof HTMLElement)) return;

    var outside = [document.getElementById("main"), document.querySelector("footer"), document.querySelector("[data-quick-contact]")];
    var focusable = function () {
      return Array.prototype.slice.call(
        menu.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      );
    };
    var isOpen = function () {
      return menu.classList.contains("is-open");
    };

    var setOpen = function (open) {
      menu.classList.toggle("is-open", open);
      menu.toggleAttribute("inert", !open);
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
      outside.forEach(function (el) {
        if (el) el.toggleAttribute("inert", open);
      });
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        var first = focusable()[0];
        if (first) first.focus({ preventScroll: true });
      } else if (menu.contains(document.activeElement) || document.activeElement === document.body) {
        trigger.focus({ preventScroll: true });
      }
    };

    trigger.addEventListener("click", function () {
      setOpen(!isOpen());
    });
    menu.addEventListener("click", function (event) {
      var target = event.target;
      if (target instanceof Element && target.closest("[data-mobile-menu-close], [data-mobile-menu-link]")) {
        setOpen(false);
      }
    });
    document.addEventListener("keydown", function (event) {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        setOpen(false);
        return;
      }
      if (event.key !== "Tab") return;
      var items = focusable();
      if (items.length === 0) return;
      var first = items[0];
      var last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    window.matchMedia("(min-width: 1025px)").addEventListener("change", function (e) {
      if (e.matches && isOpen()) setOpen(false);
    });
  })();
</script>
