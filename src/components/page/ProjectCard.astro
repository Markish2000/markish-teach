---
import { Picture } from "astro:assets";
import { getTranslations } from "@i18n";
import { projectPath, type Project } from "@/lib/content";

interface Props {
  readonly project: Project;
  readonly headingLevel?: "h2" | "h3";
  readonly eager?: boolean;
}

const { project, headingLevel = "h3", eager = false } = Astro.props;
const p = project.data;
const t = getTranslations(p.locale);
const Heading = headingLevel;
const href = projectPath(project);
---

<article class="case-card">
  <div class="head">
    <div>
      <p class="industry">{p.industry}</p>
      <Heading class="ttl"><a href={href} class="card-link">{p.name}</a></Heading>
    </div>
    <span class:list={["badge", p.status === "in-development" && "is-dev"]}>{t.work.status[p.status]}</span>
  </div>

  <div class="preview">
    <Picture
      src={p.image}
      alt={p.imageAlt}
      formats={["avif", "webp"]}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1100px) 33vw, (min-width: 760px) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="preview-img"
    />
  </div>

  <p class="case-relation">{t.work.relation[p.relation]}</p>
  <p class="case-desc">{p.description}</p>

  <div class="case-actions">
    <span class="case-cta" aria-hidden="true">{t.work.case} <span>&rarr;</span></span>
    <a class="case-site" href={p.url} target="_blank" rel="noopener noreferrer">
      {t.work.site}<span class="sr-only"> {p.name} {t.a11y.new_tab}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
