---
import type { Locale } from "@shared/types";
import { localePath } from "@shared/constants";
import { getTranslations } from "@i18n";
import { getServices, servicePath } from "@/lib/content";
import SectionHead from "@shared/components/sections/SectionHead.astro";
import IconShape from "@shared/components/primitives/IconShape.astro";

interface Props {
  readonly locale: Locale;
  /** Heading level of the cards: 3 under a section h2 (home), 2 on the services page. */
  readonly cardHeading?: "h2" | "h3";
  readonly showHead?: boolean;
}

const { locale, cardHeading = "h3", showHead = true } = Astro.props;
const t = getTranslations(locale).services;
const services = await getServices(locale);
const CardHeading = cardHeading;

const ICONS: Record<string, string> = {
  "web-development": "M4 7h16M4 12h16M4 17h10",
  "custom-software": "M4 7h6v6H4z M14 4h6v6h-6z M14 14h6v6h-6z M4 14h6v6H4z",
  "seo-performance": "M3 12h4l3-7 4 14 3-7h4",
  accessibility: "M12 4a8 8 0 100 16 8 8 0 000-16zm0 4v4l3 2",
  automation: "M5 19V5l7 7 7-7v14",
};
---

<section id="services" class="services" aria-labelledby={showHead ? "services-title" : undefined}>
  <div class="container-mk">
    {showHead && <SectionHead id="services" eyebrow={t.eyebrow} title={t.title} meta={t.meta} />}
    <div class="services-grid reveal-group">
      {services.map((service, index) => (
        <article class:list={["service", { "is-feature": index === 0 }]}>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
            <IconShape>
              <svg viewBox="0 0 24 24" fill="none">
                <path d={ICONS[service.data.key] ?? ICONS["web-development"]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </IconShape>
            <span class="num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          </div>
          <CardHeading class="service-title">
            <a href={servicePath(service)} class="card-link">{service.data.name}</a>
          </CardHeading>
          <p>{service.data.card}</p>
          <div class="service-foot" aria-hidden="true">
            <span>{t.more}</span>
            <svg width="14" height="14" viewBox="0 0 16 16">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </article>
      ))}
    </div>
    {showHead && (
      <p class="section-more">
        <a href={localePath(locale, "services")}>{t.all} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</section>
