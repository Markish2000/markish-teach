---
import type { Locale } from "@shared/types";
import { CONTACT, localePath } from "@shared/constants";
import { getTranslations } from "@i18n";
import Eyebrow from "@shared/components/primitives/Eyebrow.astro";
import Button from "@shared/components/primitives/Button.astro";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="cta" aria-labelledby="cta-title">
  <div class="container-mk">
    <div class="cta-block">
      <div class="inner reveal-group">
        <div>
          <Eyebrow text={t.cta.eyebrow} />
          <h2 id="cta-title" style="margin-top: 18px; white-space: pre-line;">{t.cta.title}</h2>
          <p class="lede" style="margin-top: 18px;">{t.cta.desc}</p>
        </div>
        <div class="cta-actions">
          <Button variant="primary" href={`${localePath(locale, "contact")}#contact-form`} label={t.cta.btn1} />
          <Button
            variant="secondary"
            href={CONTACT.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            label={t.cta.btn2}
            srHint={t.a11y.new_tab}
          />
        </div>
      </div>
    </div>
  </div>
</section>
