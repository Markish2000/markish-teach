---
import type { Locale } from "@shared/types";
import { CONTACT, localePath } from "@shared/constants";
import { getTranslations } from "@i18n";
import SectionHead from "@shared/components/sections/SectionHead.astro";
import ContactForm from "@components/interactive/ContactForm.astro";

interface Props {
  readonly locale: Locale;
  /** On the contact page the section title is the page h1 instead of an h2. */
  readonly showHead?: boolean;
}

const { locale, showHead = true } = Astro.props;
const t = getTranslations(locale);
const c = t.contact;
---

<section id="contact" aria-labelledby={showHead ? "contact-title" : "channels-title"}>
  <div class="container-mk">
    {showHead && <SectionHead id="contact" eyebrow={c.eyebrow} title={c.title} meta={c.meta} />}
    <div class="contact-grid reveal-group">
      <ContactForm locale={locale} privacyHref={localePath(locale, "privacy")} />
      <aside class="contact-aside" aria-labelledby="channels-title">
        <h2 id="channels-title" class="contact-aside-title">{c.channels_title}</h2>
        <dl>
          <div class="row">
            <dt class="lbl">{c.info.email}</dt>
            <dd class="val"><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
          </div>
          <div class="row">
            <dt class="lbl">{c.info.whatsapp}</dt>
            <dd class="val">
              <a href={CONTACT.whatsappUrl} target="_blank" rel="noopener noreferrer">
                {CONTACT.whatsappDisplay}<span class="sr-only"> {t.a11y.new_tab}</span>
              </a>
            </dd>
          </div>
          <div class="row">
            <dt class="lbl">{c.info.location}</dt>
            <dd class="val">{c.info.location_val}</dd>
          </div>
          <div class="row">
            <dt class="lbl">{c.info.hours}</dt>
            <dd class="val">{c.info.hours_val}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</section>
