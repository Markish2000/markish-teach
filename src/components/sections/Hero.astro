---
import type { Locale } from "@shared/types";
import { localePath } from "@shared/constants";
import { getTranslations } from "@i18n";
import Button from "@shared/components/primitives/Button.astro";
import LogoMark from "@shared/components/brand/LogoMark.astro";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).hero;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <LogoMark className="hero-watermark" size={560} data-parallax="-0.06" />
  <div class="hero-coords" aria-hidden="true">
    <span>{t.coords}</span>
  </div>
  <div class="container-mk">
    <div class="hero-grid">
      <!-- No entrance animation above the fold: the headline paints with the first frame. -->
      <div>
        <div class="hero-meta-row">
          <p class="eyebrow">{t.eyebrow}</p>
        </div>
        <h1 id="hero-title">
          <span class="word">{t.title_a}</span>{" "}
          <span class="word accent-word">{t.title_b}</span>
          <span class="word">{t.title_c}</span>
        </h1>
        <p class="lede" style="margin-top: 28px;">{t.subtitle}</p>
        <div class="hero-cta">
          <Button variant="primary" href={localePath(locale, "contact")} label={t.cta_primary} />
          <Button variant="secondary" href={localePath(locale, "projects")} label={t.cta_secondary} />
        </div>
        <ul class="hero-trust">
          {t.facts.map((fact) => (
            <li class="stat">
              <span class="num">{fact.num}</span>
              <span class="label">{fact.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <div class="hero-3d-mount" data-hero-3d-mount>
          <div class="hero-3d-fallback" data-hero-3d-fallback>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
        {t.hud.map((panel, index) => (
          <div class={`hud-panel p${index + 1}`}>
            <div class="label">{panel.label}</div>
            <div class="value">{panel.value}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * The 3D scene is decorative, so it never competes with the content:
   * it loads only after the page has fully loaded and the browser is idle,
   * only while the hero is on screen, and never on devices or settings where
   * it would hurt (reduced motion, data saver, low memory or few CPU cores).
   * On touch or narrow screens it waits for the first interaction, so phones
   * never pay for it during the initial load. The CSS fallback stays visible
   * until then, and in every case where the scene is skipped.
   */
  type NavigatorHints = Navigator & {
    deviceMemory?: number;
    connection?: { saveData?: boolean };
  };

  const canRender3D = (): boolean => {
    const nav = navigator as NavigatorHints;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
    if (nav.connection?.saveData) return false;
    if ((nav.deviceMemory ?? 8) < 4) return false;
    if ((nav.hardwareConcurrency ?? 8) < 4) return false;
    return true;
  };

  const mountHero3D = async (mount: HTMLElement): Promise<void> => {
    if (import.meta.env.DEV) {
      await import("@vitejs/plugin-react/preamble");
    }
    const [{ createElement }, { createRoot }, { default: Hero3D }] = await Promise.all([
      import("react"),
      import("react-dom/client"),
      import("@components/three/Hero3D"),
    ]);
    createRoot(mount).render(createElement(Hero3D));
  };

  const whenIdle = (callback: () => void): void => {
    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(callback, { timeout: 4000 });
    } else {
      setTimeout(callback, 2000);
    }
  };

  const schedule = (mount: HTMLElement): void => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        whenIdle(() => void mountHero3D(mount));
      },
      { threshold: 0.05 }
    );
    observer.observe(mount);
  };

  const waitForInteraction = (mount: HTMLElement): void => {
    const events = ["pointerdown", "keydown", "wheel", "touchstart"] as const;
    const start = (): void => {
      events.forEach((name) => window.removeEventListener(name, start));
      schedule(mount);
    };
    events.forEach((name) => window.addEventListener(name, start, { once: true, passive: true }));
  };

  const mount = document.querySelector<HTMLElement>("[data-hero-3d-mount]");
  if (mount && canRender3D() && "IntersectionObserver" in window) {
    const deferUntilInteraction = window.matchMedia("(max-width: 1024px), (pointer: coarse)").matches;
    const begin = (): void => (deferUntilInteraction ? waitForInteraction(mount) : schedule(mount));
    if (document.readyState === "complete") begin();
    else window.addEventListener("load", begin, { once: true });
  }
</script>
