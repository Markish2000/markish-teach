---
import type { Locale } from "@shared/types";
import { getTranslations } from "@i18n";
import { findByKey, servicePath } from "@/lib/content";
import SectionHead from "@shared/components/sections/SectionHead.astro";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).problems;
const items = await Promise.all(
  t.items.map(async (item) => ({ ...item, href: servicePath(await findByKey("services", locale, item.service)) })),
);
---

<section id="problems" class="problems" aria-labelledby="problems-title">
  <div class="container-mk">
    <SectionHead id="problems" eyebrow={t.eyebrow} title={t.title} meta={t.meta} />
    <ul class="problems-grid reveal-group">
      {items.map((item, index) => (
        <li class="problem-row">
          <span class="idx" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="ttl"><a href={item.href} class="card-link">{item.ttl}</a></h3>
            <p class="desc">{item.desc}</p>
          </div>
          <svg class="arrow" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </li>
      ))}
    </ul>
  </div>
</section>
