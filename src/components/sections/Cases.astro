---
import type { Locale } from "@shared/types";
import { localePath } from "@shared/constants";
import { getTranslations } from "@i18n";
import { getProjects, type Project } from "@/lib/content";
import SectionHead from "@shared/components/sections/SectionHead.astro";
import ProjectCard from "@components/page/ProjectCard.astro";

interface Props {
  readonly locale: Locale;
  /** Pre-filtered list (projects page); defaults to every project. */
  readonly projects?: ReadonlyArray<Project>;
  readonly showHead?: boolean;
  readonly headingLevel?: "h2" | "h3";
}

const { locale, showHead = true, headingLevel = "h3" } = Astro.props;
const t = getTranslations(locale).work;
const projects = Astro.props.projects ?? (await getProjects(locale));
---

<section id="work" class="cases" aria-labelledby={showHead ? "work-title" : undefined}>
  <div class="container-mk">
    {showHead && <SectionHead id="work" eyebrow={t.eyebrow} title={t.title} meta={t.meta} />}
    <div class="cases-grid reveal-group">
      {projects.map((project) => (
        <ProjectCard project={project} headingLevel={headingLevel} />
      ))}
    </div>
    {showHead && (
      <p class="section-more">
        <a href={localePath(locale, "projects")}>{t.all} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</section>
