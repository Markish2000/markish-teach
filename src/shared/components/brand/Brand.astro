---
import { Image } from "astro:assets";
import LogoMark from "./LogoMark.astro";
import lockupLight from "../../../assets/markish-lockup-light.png";
import lockupDark from "../../../assets/markish-lockup-dark.png";

interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  readonly href: string;
  /** Accessible name of the link (the images are decorative). */
  readonly label: string;
  readonly text?: string;
  /** `lockup` uses the full horizontal logo; `mark` the symbol plus text. */
  readonly variant?: "mark" | "lockup";
  /** `lazy` for instances below the fold, like the footer. */
  readonly loading?: "eager" | "lazy";
}

const { href, label, text = "Markish Tech.", variant = "mark", loading = "eager", ...rest } = Astro.props;
---

{
  variant === "lockup" ? (
    <a class="brand brand-lockup" href={href} aria-label={label} {...rest}>
      <Image
        class="brand-lockup-img is-light"
        src={lockupLight}
        alt=""
        width={200}
        densities={[2]}
        loading={loading}
        decoding="async"
      />
      <Image
        class="brand-lockup-img is-dark"
        src={lockupDark}
        alt=""
        width={200}
        densities={[2]}
        loading={loading}
        decoding="async"
      />
    </a>
  ) : (
    <a class="brand" href={href} aria-label={label} {...rest}>
      <span class="brand-mark">
        <LogoMark size={32} />
      </span>
      <span>{text}</span>
    </a>
  )
}
