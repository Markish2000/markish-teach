---
import type { GetStaticPaths } from "astro";
import { getPublishedPosts, type Post } from "@/lib/content";
import PostView from "@/views/PostView.astro";

// Only published posts get a route; drafts never reach the build output.
export const getStaticPaths = (async () =>
  (await getPublishedPosts("es")).map((post) => ({
    params: { slug: post.id.split("/").pop() },
    props: { post },
  }))) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
---

<PostView post={post} />
