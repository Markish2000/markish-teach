---
import { localePath } from "@shared/constants";
import { getTranslations } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/page/PageHero.astro";

// One static 404 for every unknown URL. Spanish is the default locale; an
// English shortcut is offered on the page itself.
const locale = "es" as const;
const t = getTranslations(locale);
const en = getTranslations("en");
const nf = t.page.not_found;
const links = (["home", "services", "projects", "faq", "contact"] as const).map((key) => ({
  label: t.nav[key],
  href: localePath(locale, key),
}));
---

<BaseLayout
  locale={locale}
  title={t.seo.not_found.title}
  description={t.seo.not_found.description}
  alternates={{ es: "/404" }}
  noindex
>
  <PageHero eyebrow={nf.eyebrow} title={nf.h1} lead={nf.lead}>
    <ul class="plain-list not-found-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <p lang="en-US">
      <a href={localePath("en", "home")} hreflang="en-US">{nf.en_hint} {en.nav.home} →</a>
    </p>
  </PageHero>
</BaseLayout>
