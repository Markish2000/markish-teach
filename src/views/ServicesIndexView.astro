---
import type { Locale } from "@shared/types";
import { localePath, sectionAlternates } from "@shared/constants";
import { absoluteUrl } from "@shared/helpers";
import { getTranslations } from "@i18n";
import { findByKey, getServices, servicePath } from "@/lib/content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/page/PageHero.astro";
import Services from "@components/sections/Services.astro";
import CtaBand from "@components/page/CtaBand.astro";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const page = t.page.services_index;
const services = await getServices(locale);
const compare = await Promise.all(
  page.compare.map(async (row) => {
    const service = await findByKey("services", locale, row.service);
    return { ...row, href: servicePath(service), name: service.data.name };
  }),
);
const path = localePath(locale, "services");
---

<BaseLayout
  locale={locale}
  title={t.seo.services.title}
  description={t.seo.services.description}
  alternates={sectionAlternates("services")}
  pageType="CollectionPage"
  navCurrent="services"
  breadcrumbs={[
    { name: t.nav.home, path: localePath(locale, "home") },
    { name: t.nav.services, path },
  ]}
  pageNode={{
    mainEntity: {
      "@type": "ItemList",
      itemListElement: services.map((s, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: absoluteUrl(servicePath(s)),
        name: s.data.name,
      })),
    },
  }}
>
  <PageHero eyebrow={t.services.eyebrow} title={page.h1} lead={page.lead} />

  <Services locale={locale} showHead={false} cardHeading="h2" />

  <section class="container-mk page-section" aria-labelledby="compare-title">
    <h2 id="compare-title">{page.compare_title}</h2>
    <ul class="compare-list">
      {compare.map((row) => (
        <li>
          <span class="compare-q">{row.q}</span>
          <a href={row.href}>{row.name} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <CtaBand locale={locale} title={t.page.service.cta_title} desc={t.page.service.cta_desc} />
</BaseLayout>
